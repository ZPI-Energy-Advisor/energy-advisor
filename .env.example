# PostgreSQL database configuration
POSTGRES_USER=energy_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=energy_advisor
POSTGRES_HOST=db

# Google OAuth2 configuration
GOOGLE_CLIENT_ID=13518631048-hm0jlnrgj7utm440e63ri5oi93s5pfu3.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}

# Frontend API configuration
VITE_API_URL=http://localhost:8000/api/v1

# CORS configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# JWT configuration
ACCESS_TOKEN_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=7
JWT_SECRET_KEY=generate_your_own_random_secret
SIGNATURE_ALGORITHM=HS256

# Dynamic prices configuration (PSE RCE, see docs/dynamic-prices.md)
# Key for POST /api/v1/dynamic-prices/sync; empty = manual sync disabled
PRICE_SYNC_ADMIN_KEY=generate_your_own_random_key

# Smart Home hub (see docs/smart-home-api.md); empty HUB_URL = Smart Home disabled
HUB_URL=http://hub:9100
# Shared key sent as X-Hub-Api-Key between backend and hub
HUB_API_KEY=generate_your_own_random_key
HUB_TIMEOUT_SECONDS=5
# Account that owns the simulated home (only it can connect the home); empty = nobody
HUB_HOME_USER_EMAIL=owner@example.com
# Backend address the hub sends device events to (POST /api/v1/home/events); empty = events are not sent
BACKEND_URL=http://backend:8000
